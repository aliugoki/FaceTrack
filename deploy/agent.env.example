# FaceTrack pipeline agent — environment
# Copy to /etc/facetrack/agent.env and fill in. Read by facetrack-agent.service.
#
# The agent is the ONLY component that runs Docker. It polls the dashboard for
# start/stop/restart jobs and launches the per-company DeepStream containers.

# Where the dashboard API lives. Same box → localhost:5002. Remote dashboard →
# use its internal URL (NOT the public https host, to skip the proxy/TLS hop).
DASHBOARD_URL=http://localhost:5002

# MUST byte-for-byte match AGENT_TOKEN in the dashboard's backend/.env, or every
# job poll comes back 403 and nothing ever launches. Generate once with:
#   openssl rand -hex 24
AGENT_TOKEN=
